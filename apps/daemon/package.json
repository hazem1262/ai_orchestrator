{
  "name": "@orc/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --platform node --target node22 --out-dir dist",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@orc/api-contract": "workspace:*",
    "@orc/core": "workspace:*",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.13"
  }
}
